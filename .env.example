# Frontend
VITE_FITAI_API_URL=http://127.0.0.1:8000
PORT=3000

# FitAI intentionally has no required proprietary cloud API key.

# --- Photorealistic try-on -------------------------------------------------
# Engine selection: auto | diffusers-inpaint | external
# 'auto' prefers a configured external checkout, then the diffusers baseline.
FITAI_VTO_ENGINE=auto

# Baseline engine (installed via backend/requirements-vto.txt).
# FITAI_VTO_BASE_MODEL=runwayml/stable-diffusion-inpainting
# FITAI_VTO_IP_ADAPTER_REPO=h94/IP-Adapter
# FITAI_VTO_IP_ADAPTER_WEIGHT=ip-adapter-plus_sd15.bin
# FITAI_VTO_IP_SCALE=0.85

# External research checkout. Its checkpoints are CC BY-NC-SA 4.0 and are NOT
# licensed for commercial use - see docs/licenses/MODEL_LICENSE_MATRIX.md.
# Placeholders: {person} {mask} {garment} {output} {category} {steps} {seed}
# FITAI_VTO_COMMAND=python C:/models/CatVTON/infer.py --person {person} --cloth {garment} --mask {mask} --output {output} --cloth_type {category}

# Hairstyle synthesis (still unimplemented; no reviewed provider yet).
# FITAI_HAIR_COMMAND=
